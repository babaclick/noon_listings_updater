# Same Clerk instance as Pforge.
# CLERK_SECRET_KEY and CLERK_JWT_ISSUER come from Pforge Backend .env.
# CLERK_PUBLISHABLE_KEY is Pforge Frontend VITE_CLERK_PUBLISHABLE_KEY.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWT_ISSUER=https://sunny-rattler-44.clerk.accounts.dev

# Origin of this service, with no path. Clerk writes it into the session token.
# On Render: https://<service-name>.onrender.com
# Add the same origin in the Clerk dashboard.
# For a local run as well, add http://localhost:8501
CLERK_AUTHORIZED_PARTIES=https://your-service.onrender.com

# Optional. Render sets RENDER_EXTERNAL_URL. Set APP_URL only for a custom domain.
# APP_URL=https://your-service.onrender.com

# Production Postgres URL. The app writes pforge.listings with this connection.
BABACLICK_PROD_DATABASE_URL=
