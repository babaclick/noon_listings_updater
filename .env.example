# Clerk Dashboard → OAuth applications.
# Redirect URI: http://localhost:8501/oauth2callback
# Scopes: openid, email, profile
CLERK_OAUTH_CLIENT_ID=
CLERK_OAUTH_CLIENT_SECRET=
CLERK_JWT_ISSUER=https://your-instance.clerk.accounts.dev
STREAMLIT_AUTH_COOKIE_SECRET=
# Optional. Defaults to http://localhost:8501/oauth2callback
CLERK_OAUTH_REDIRECT_URI=http://localhost:8501/oauth2callback

# Production Postgres URL. The app writes pforge.listings with this connection.
BABACLICK_PROD_DATABASE_URL=
